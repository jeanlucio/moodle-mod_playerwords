<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/playerwords/db" VERSION="20260428" COMMENT="XMLDB file for mod_playerwords"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="playerwords" COMMENT="Each record is one PlayerWords activity instance">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Course this activity belongs to"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Activity name"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Activity description"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="sources" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false"
            COMMENT="Bitmask for enabled sources: manual, glossary, ai"/>
<FIELD NAME="glossaryid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
            COMMENT="Glossary to sync words from; 0 means all glossaries in the course"/>
        <FIELD NAME="min_length" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="4" SEQUENCE="false"
            COMMENT="Minimum allowed word length"/>
        <FIELD NAME="max_length" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="6" SEQUENCE="false"
            COMMENT="Maximum allowed word length"/>
        <FIELD NAME="max_attempts" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="6" SEQUENCE="false"
            COMMENT="Maximum attempts per round"/>
        <FIELD NAME="timer_seconds" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
            COMMENT="Optional timer in seconds, 0 means disabled"/>
<FIELD NAME="show_ranking" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"
            COMMENT="Whether ranking is shown to students"/>
        <FIELD NAME="wordmode" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false"
            COMMENT="Word selection mode: 1=random per round, 2=word of the day"/>
        <FIELD NAME="max_rounds" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
            COMMENT="Maximum rounds per user, 0 means unlimited"/>
        <FIELD NAME="cooldown_seconds" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="86400" SEQUENCE="false"
            COMMENT="Cooldown between rounds in seconds, 0 means disabled"/>
        <FIELD NAME="completionattempts" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
            COMMENT="Required attempts for custom completion rule"/>
        <FIELD NAME="grade" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="100.00000" SEQUENCE="false"
            DECIMALS="5" COMMENT="Maximum grade value"/>
        <FIELD NAME="gradepass" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="0.00000" SEQUENCE="false"
            DECIMALS="5" COMMENT="Minimum passing grade"/>
        <FIELD NAME="grademethod" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false"
            COMMENT="Grade aggregation: 1=highest, 2=average, 3=first, 4=last"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course_ix" UNIQUE="false" FIELDS="course"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="playerwords_words" COMMENT="Approved words available for rounds">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="playerwordsid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="word" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Game word"/>
        <FIELD NAME="concept" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"
            COMMENT="Original concept name; set when word is extracted from a multi-word glossary entry"/>
        <FIELD NAME="hint" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Optional hint"/>
        <FIELD NAME="source" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="manual" SEQUENCE="false"
            COMMENT="Word source: manual, glossary or ai"/>
        <FIELD NAME="glossaryid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"
            COMMENT="ID of the glossary this word was imported from; 0 for manual/ai words"/>
        <FIELD NAME="approved" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="addedby" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_playerwords" TYPE="foreign" FIELDS="playerwordsid" REFTABLE="playerwords" REFFIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="addedby" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="playerwordsid_ix" UNIQUE="false" FIELDS="playerwordsid"/>
        <INDEX NAME="approved_ix" UNIQUE="false" FIELDS="approved"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="playerwords_attempts" COMMENT="Student round attempts and score metadata">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="playerwordsid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="wordid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="attempts_used" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="time_used" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="completed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="score" TYPE="number" LENGTH="10" NOTNULL="true" DEFAULT="0.00000" SEQUENCE="false"
            DECIMALS="5"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="fk_playerwords" TYPE="foreign" FIELDS="playerwordsid" REFTABLE="playerwords" REFFIELDS="id"/>
        <KEY NAME="fk_user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
        <KEY NAME="fk_word" TYPE="foreign" FIELDS="wordid" REFTABLE="playerwords_words" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="playerwordsid_userid_ix" UNIQUE="false" FIELDS="playerwordsid, userid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
