{{!
    @template mod_playerwords/game

    Game interface for a PlayerWords round.

    Example context (json):
    {
        "cmid": 1,
        "sesskey": "abc123",
        "canmanagewords": true,
        "managewordsbutton": "Manage words",
        "managewordsurl": "https://example.com/mod/playerwords/managewords.php?id=1",
        "hastargetword": true,
        "nogamewords": "No approved words are available for this activity yet.",
        "attemptslabel": "Attempts",
        "attemptsused": 3,
        "maxattempts": 6,
        "timerenabled": false,
        "timerlabel": "Time left (s):",
        "timeleft": 0,
        "showhint": true,
        "hintlabel": "Hint",
        "hintvalue": "Regime autoritário que durou de 1964 a 1985.",
        "rows": [
            {
                "letters": [
                    {"letter": "M", "state": "correct"},
                    {"letter": "I", "state": "correct"},
                    {"letter": "L", "state": "correct"},
                    {"letter": "I", "state": "correct"},
                    {"letter": "T", "state": "correct"},
                    {"letter": "A", "state": "correct"},
                    {"letter": "R", "state": "correct"}
                ]
            },
            {"letters": [{"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}]},
            {"letters": [{"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}]},
            {"letters": [{"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}]},
            {"letters": [{"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}]},
            {"letters": [{"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}]}
        ],
        "roundfinished": true,
        "feedbackmessage": "Impressive!",
        "showreveal": true,
        "revealwordlabel": "The word was:",
        "revealword": "Militar",
        "showrevealconcept": true,
        "revealconcept": "Ditadura Militar",
        "showdefinition": true,
        "revealdefinition": "Regime autoritário que durou de 1964 a 1985.",
        "cooldowntext": "23h 59m 45s",
        "cooldowncountdownlabel": "Next round in",
        "newroundready": "Ready to play!",
        "guesslabel": "Your guess",
        "guessplaceholder": "Type a word",
        "guessmaxlength": 7,
        "submitguess": "Submit guess",
        "forfeitlabel": "Give up",
        "forfeitconfirm": "Are you sure you want to give up?",
        "newroundlabel": "Start a new round"
    }
}}
<div class="mod-playerwords-game">
    {{#canmanagewords}}
        <p>
            <a href="{{{managewordsurl}}}" class="btn btn-secondary">{{managewordsbutton}}</a>
        </p>
    {{/canmanagewords}}

    {{^hastargetword}}
        <div class="alert alert-warning">{{nogamewords}}</div>
    {{/hastargetword}}

    {{#hastargetword}}
        <div class="mod-playerwords-status mb-3">
            <span><strong>{{attemptslabel}}</strong> {{attemptsused}} / {{maxattempts}}</span>
            {{#timerenabled}}
                <span class="ms-3"><strong>{{timerlabel}}</strong> {{timeleft}}</span>
            {{/timerenabled}}
        </div>
        {{#canhint}}
            <form method="post" action="{{{config.wwwroot}}}/mod/playerwords/view.php" class="mb-2">
                <input type="hidden" name="id" value="{{cmid}}">
                <input type="hidden" name="revealhint" value="1">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="btn btn-outline-info btn-sm">{{hintbuttonlabel}}</button>
            </form>
        {{/canhint}}
        {{#showhint}}
            <div class="alert alert-info"><strong>{{hintlabel}}</strong> {{hintvalue}}</div>
        {{/showhint}}

        <div class="mod-playerwords-grid mb-3" role="img" aria-label="{{attemptslabel}}">
            {{#rows}}
                <div class="mod-playerwords-row">
                    {{#letters}}
                        <span class="mod-playerwords-cell is-{{state}}" aria-label="{{arialabel}}">{{letter}}</span>
                    {{/letters}}
                </div>
            {{/rows}}
        </div>

        {{^roundfinished}}
            <div class="d-flex align-items-end">
                <form method="post"
                      action="{{{config.wwwroot}}}/mod/playerwords/view.php"
                      class="mod-playerwords-form flex-grow-1 me-2">
                    <input type="hidden" name="id" value="{{cmid}}">
                    <input type="hidden" name="submitguess" value="1">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <label for="playerwords-guess" class="form-label">{{guesslabel}}</label>
                    <input
                        type="text"
                        id="playerwords-guess"
                        name="guess"
                        maxlength="{{guessmaxlength}}"
                        class="form-control"
                        placeholder="{{guessplaceholder}}"
                        required
                    >
                    <button type="submit" class="btn btn-primary mt-2">{{submitguess}}</button>
                </form>
                <form id="playerwords-forfeit-form"
                      method="post"
                      action="{{{config.wwwroot}}}/mod/playerwords/view.php"
                      class="flex-shrink-0"
                      data-title="{{forfeitlabel}}"
                      data-confirm="{{forfeitconfirm}}">
                    <input type="hidden" name="id" value="{{cmid}}">
                    <input type="hidden" name="forfeit" value="1">
                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                    <button type="submit" class="btn btn-outline-danger btn-sm">{{forfeitlabel}}</button>
                </form>
            </div>
        {{/roundfinished}}

        {{#roundfinished}}
            {{#feedbackmessage}}
                <p class="mod-playerwords-feedback fw-bold mt-3">{{feedbackmessage}}</p>
            {{/feedbackmessage}}
            {{#showreveal}}
                <div class="mod-playerwords-reveal alert alert-secondary mt-3">
                    <p class="mb-1"><strong>{{revealwordlabel}}</strong> {{revealword}}</p>
                    {{#showrevealconcept}}
                        <p class="mb-0">
                            <strong>{{revealconcept}}</strong>{{#showdefinition}}: {{revealdefinition}}{{/showdefinition}}
                        </p>
                    {{/showrevealconcept}}
                    {{^showrevealconcept}}
                        {{#showdefinition}}
                            <p class="mb-0 mt-1">{{revealdefinition}}</p>
                        {{/showdefinition}}
                    {{/showrevealconcept}}
                </div>
            {{/showreveal}}
            {{#cooldowntext}}
                <p class="text-muted mt-2">
                    {{cooldowncountdownlabel}}
                    <strong>
                        <span id="playerwords-cooldown-countdown"
                              data-ready="{{newroundready}}">{{cooldowntext}}</span>
                    </strong>
                </p>
            {{/cooldowntext}}
            <form method="post" action="{{{config.wwwroot}}}/mod/playerwords/view.php" class="mt-2">
                <input type="hidden" name="id" value="{{cmid}}">
                <input type="hidden" name="newround" value="1">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="btn btn-secondary">{{newroundlabel}}</button>
            </form>
        {{/roundfinished}}
    {{/hastargetword}}
</div>
