<div class="mod-playerwords-game">
    <div class="pw-header">
        {{> mod_playerwords/toolbar}}
        {{#timerenabled}}
            <span id="playerwords-timer-wrapper" class="pw-header-timer"{{#showlobby}} hidden{{/showlobby}}>
                <i class="fa fa-clock-o" aria-hidden="true"></i>
                <span id="playerwords-timer-countdown" aria-label="{{timerlabel}}">{{timeleft}}</span>
            </span>
        {{/timerenabled}}
    </div>

    {{^hastargetword}}
        <div class="alert alert-warning">{{nogamewords}}</div>
    {{/hastargetword}}

    {{#hastargetword}}
        <div id="playerwords-stage">
            {{#showlobby}}
                {{> mod_playerwords/lobby}}
            {{/showlobby}}
            {{^showlobby}}
                {{> mod_playerwords/round_panel}}
            {{/showlobby}}
        </div>
    {{/hastargetword}}

    <div id="playerwords-live-region"
         class="visually-hidden sr-only"
         aria-live="polite"
         aria-atomic="true"></div>

    <div id="playerwords-help-content" hidden>
        {{> mod_playerwords/help_body}}
    </div>
</div>
