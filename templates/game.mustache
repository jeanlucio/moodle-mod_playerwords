{{!
    @template mod_playerwords/game

    Game interface for a PlayerWords round.

    Example context (json):
    {
        "cmid": 1,
        "sesskey": "abc123",
        "canmanagewords": true,
        "managewordsbutton": "Manage words",
        "managewordsurl": "https://example.com/mod/playerwords/managewords.php?id=1",
        "hastargetword": true,
        "nogamewords": "No approved words are available for this activity yet.",
        "attemptslabel": "Attempts",
        "attemptsused": 3,
        "maxattempts": 6,
        "timerenabled": false,
        "timerlabel": "Time left (s):",
        "timeleft": 0,
        "showhint": true,
        "hintlabel": "Hint",
        "hintvalue": "Regime autoritário que durou de 1964 a 1985.",
        "rows": [
            {
                "letters": [
                    {"letter": "M", "state": "correct"},
                    {"letter": "I", "state": "correct"},
                    {"letter": "L", "state": "correct"},
                    {"letter": "I", "state": "correct"},
                    {"letter": "T", "state": "correct"},
                    {"letter": "A", "state": "correct"},
                    {"letter": "R", "state": "correct"}
                ]
            },
            {"letters": [{"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}]},
            {"letters": [{"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}]},
            {"letters": [{"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}]},
            {"letters": [{"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}]},
            {"letters": [{"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}, {"letter": "", "state": "empty"}]}
        ],
        "roundfinished": true,
        "feedbackmessage": "Impressive!",
        "showreveal": true,
        "revealwordlabel": "The word was:",
        "revealword": "Militar",
        "showrevealconcept": true,
        "revealconcept": "Ditadura Militar",
        "showdefinition": true,
        "revealdefinition": "Regime autoritário que durou de 1964 a 1985.",
        "cooldownactive": false,
        "cooldowntext": "23h 59m 45s",
        "cooldowncountdownlabel": "Next round in",
        "guesslabel": "Your guess",
        "guessplaceholder": "Type a word",
        "guessmaxlength": 7,
        "submitguess": "Submit guess",
        "forfeitlabel": "Give up",
        "forfeitconfirm": "Are you sure you want to give up?",
        "newroundlabel": "Start a new round"
    }
}}
<div class="mod-playerwords-game">
    {{#canmanagewords}}
        <p>
            <a href="{{{managewordsurl}}}" class="btn btn-secondary">{{managewordsbutton}}</a>
        </p>
    {{/canmanagewords}}

    {{^hastargetword}}
        <div class="alert alert-warning">{{nogamewords}}</div>
    {{/hastargetword}}

    {{#hastargetword}}
        <div class="mod-playerwords-status">
            <span><strong>{{attemptslabel}}</strong> {{attemptsused}} / {{maxattempts}}</span>
            {{#timerenabled}}
                <span class="ms-3">
                    <strong>{{timerlabel}}</strong>
                    <span id="playerwords-timer-countdown">{{timeleft}}</span>
                </span>
            {{/timerenabled}}
        </div>
        {{#canhint}}
            <form method="post" action="{{{config.wwwroot}}}/mod/playerwords/view.php?id={{cmid}}" class="mb-2">
                <input type="hidden" name="revealhint" value="1">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="btn btn-outline-info btn-sm">{{hintbuttonlabel}}</button>
            </form>
        {{/canhint}}
        {{#showhint}}
            <div class="alert alert-info"><strong>{{hintlabel}}</strong> {{hintvalue}}</div>
        {{/showhint}}

        <div class="mod-playerwords-grid mb-3" role="img" aria-label="{{attemptslabel}}">
            {{#rows}}
                <div class="mod-playerwords-row">
                    {{#letters}}
                        <span class="mod-playerwords-cell is-{{state}}" aria-label="{{arialabel}}">{{letter}}</span>
                    {{/letters}}
                </div>
            {{/rows}}
        </div>

        {{^roundfinished}}
        <div>
            <form id="playerwords-guess-form"
                  method="post"
                  action="{{{config.wwwroot}}}/mod/playerwords/view.php?id={{cmid}}"
                  class="mod-playerwords-form">
                <input type="hidden" name="submitguess" value="1">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <label for="playerwords-guess" class="form-label">{{guesslabel}}</label>
                <input
                    type="text"
                    id="playerwords-guess"
                    name="guess"
                    maxlength="{{guessmaxlength}}"
                    class="form-control"
                    placeholder="{{guessplaceholder}}"
                    inputmode="none"
                    autocomplete="off"
                    required
                >
            </form>
            <form id="playerwords-forfeit-form"
                  method="post"
                  action="{{{config.wwwroot}}}/mod/playerwords/view.php?id={{cmid}}"
                  data-title="{{forfeitlabel}}"
                  data-confirm="{{forfeitconfirm}}">
                <input type="hidden" name="forfeit" value="1">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
            </form>
            <div class="d-flex gap-2 mt-2 mod-playerwords-actions">
                <button type="submit" form="playerwords-guess-form" class="btn btn-primary flex-grow-1">{{submitguess}}</button>
                <button type="submit" form="playerwords-forfeit-form" class="btn btn-outline-danger flex-grow-1">{{forfeitlabel}}</button>
            </div>
            <div id="playerwords-keyboard" class="mod-playerwords-keyboard" role="group" aria-label="{{keyboardlabel}}">
                <div class="mod-playerwords-keyboard-row">
                    <button type="button" class="pw-key" data-key="Q" tabindex="-1">Q</button>
                    <button type="button" class="pw-key" data-key="W" tabindex="-1">W</button>
                    <button type="button" class="pw-key" data-key="E" tabindex="-1">E</button>
                    <button type="button" class="pw-key" data-key="R" tabindex="-1">R</button>
                    <button type="button" class="pw-key" data-key="T" tabindex="-1">T</button>
                    <button type="button" class="pw-key" data-key="Y" tabindex="-1">Y</button>
                    <button type="button" class="pw-key" data-key="U" tabindex="-1">U</button>
                    <button type="button" class="pw-key" data-key="I" tabindex="-1">I</button>
                    <button type="button" class="pw-key" data-key="O" tabindex="-1">O</button>
                    <button type="button" class="pw-key" data-key="P" tabindex="-1">P</button>
                </div>
                <div class="mod-playerwords-keyboard-row">
                    <button type="button" class="pw-key" data-key="A" tabindex="-1">A</button>
                    <button type="button" class="pw-key" data-key="S" tabindex="-1">S</button>
                    <button type="button" class="pw-key" data-key="D" tabindex="-1">D</button>
                    <button type="button" class="pw-key" data-key="F" tabindex="-1">F</button>
                    <button type="button" class="pw-key" data-key="G" tabindex="-1">G</button>
                    <button type="button" class="pw-key" data-key="H" tabindex="-1">H</button>
                    <button type="button" class="pw-key" data-key="J" tabindex="-1">J</button>
                    <button type="button" class="pw-key" data-key="K" tabindex="-1">K</button>
                    <button type="button" class="pw-key" data-key="L" tabindex="-1">L</button>
                    <button type="button" class="pw-key" data-key="Ç" tabindex="-1">Ç</button>
                </div>
                <div class="mod-playerwords-keyboard-row">
                    <button type="button"
                            class="pw-key pw-key-wide"
                            data-key="ENTER"
                            tabindex="-1"
                            aria-label="{{keyboardenterlabel}}">&#x21b5;</button>
                    <button type="button" class="pw-key" data-key="Z" tabindex="-1">Z</button>
                    <button type="button" class="pw-key" data-key="X" tabindex="-1">X</button>
                    <button type="button" class="pw-key" data-key="C" tabindex="-1">C</button>
                    <button type="button" class="pw-key" data-key="V" tabindex="-1">V</button>
                    <button type="button" class="pw-key" data-key="B" tabindex="-1">B</button>
                    <button type="button" class="pw-key" data-key="N" tabindex="-1">N</button>
                    <button type="button" class="pw-key" data-key="M" tabindex="-1">M</button>
                    <button type="button"
                            class="pw-key pw-key-wide"
                            data-key="BACKSPACE"
                            tabindex="-1"
                            aria-label="{{keyboardbackspacelabel}}">&#x232b;</button>
                </div>
            </div>
        </div>
        {{/roundfinished}}

        {{#roundfinished}}
            {{#feedbackmessage}}
                <p class="mod-playerwords-feedback fw-bold mt-3">{{feedbackmessage}}</p>
            {{/feedbackmessage}}
            {{#showreveal}}
                <div class="mod-playerwords-reveal alert alert-secondary mt-3">
                    <p class="mb-1"><strong>{{revealwordlabel}}</strong> {{revealword}}</p>
                    {{#showrevealconcept}}
                        <p class="mb-0">
                            <strong>{{revealconcept}}</strong>{{#showdefinition}}: {{revealdefinition}}{{/showdefinition}}
                        </p>
                    {{/showrevealconcept}}
                    {{^showrevealconcept}}
                        {{#showdefinition}}
                            <p class="mb-0 mt-1">{{revealdefinition}}</p>
                        {{/showdefinition}}
                    {{/showrevealconcept}}
                </div>
            {{/showreveal}}
            {{#cooldowntext}}
                <p class="text-muted mt-2">
                    {{cooldowncountdownlabel}}
                    <strong>
                        <span id="playerwords-cooldown-countdown">{{cooldowntext}}</span>
                    </strong>
                </p>
            {{/cooldowntext}}
            {{^cooldownactive}}
            <form method="post" action="{{{config.wwwroot}}}/mod/playerwords/view.php?id={{cmid}}" class="mt-2">
                <input type="hidden" name="newround" value="1">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <button type="submit" class="btn btn-secondary">{{newroundlabel}}</button>
            </form>
            {{/cooldownactive}}
        {{/roundfinished}}
    {{/hastargetword}}
</div>
