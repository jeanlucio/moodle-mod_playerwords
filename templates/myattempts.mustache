{{!
    @template mod_playerwords/myattempts

    Own attempt history page for a PlayerWords activity.

    Example context (json):
    {
        "activityname": "Vocabulário — Revolução Industrial",
        "activityurl": "https://example.com/mod/playerwords/view.php?id=1",
        "backlabel": "Back to game",
        "myattemptstitle": "My attempts",
        "wordlabel": "Word",
        "attemptslabel": "Attempts",
        "timelabel": "Time",
        "scorelabel": "Score",
        "datelabel": "Date",
        "emptylabel": "You have not finished any rounds yet.",
        "showgrade": true,
        "gradesummary": "Highest grade: 8.00 / 10.00.",
        "isempty": false,
        "rows": [
            {"word": "República", "attemptsused": 3, "timeused": "1:24", "won": true, "score": "10.00", "datefinished": "1 January 2026, 10:00 AM"},
            {"word": "Império", "attemptsused": 6, "timeused": "2:05", "won": false, "score": "0.00", "datefinished": "31 December 2025, 4:30 PM"}
        ]
    }
}}
<div class="mod-playerwords-myattempts-page">
    <p>
        <a href="{{activityurl}}" class="btn btn-secondary btn-sm">{{backlabel}}</a>
    </p>
    <h2>{{myattemptstitle}}</h2>
    {{#showgrade}}
        <p>{{gradesummary}}</p>
    {{/showgrade}}
    {{#isempty}}
        <p class="text-muted">{{emptylabel}}</p>
    {{/isempty}}
    {{^isempty}}
        <table class="table table-sm mod-playerwords-myattempts-table">
            <thead>
                <tr>
                    <th scope="col">{{wordlabel}}</th>
                    <th scope="col" class="text-end">{{attemptslabel}}</th>
                    <th scope="col" class="text-end">{{timelabel}}</th>
                    <th scope="col" class="text-end">{{scorelabel}}</th>
                    <th scope="col">{{datelabel}}</th>
                </tr>
            </thead>
            <tbody>
                {{#rows}}
                    <tr>
                        <td>{{word}}</td>
                        <td class="text-end">{{attemptsused}}</td>
                        <td class="text-end">{{timeused}}</td>
                        <td class="text-end">{{score}}</td>
                        <td>{{datefinished}}</td>
                    </tr>
                {{/rows}}
            </tbody>
        </table>
    {{/isempty}}
</div>
