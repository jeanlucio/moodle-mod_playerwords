{{!
    @template mod_playerwords/round_panel

    Active-round panel: status line, hint control and letter grid, followed by either
    the guess/keyboard controls (mod_playerwords/round_play) or the post-round result
    (mod_playerwords/round_result), depending on whether the round has finished.

    Example context (json):
    {
        "attemptslabel": "Attempts",
        "attemptsused": 3,
        "maxattempts": 6,
        "timerenabled": false,
        "timerlabel": "Time left (s):",
        "timeleft": 0,
        "canhint": true,
        "hintbuttonlabel": "Hint",
        "showhint": true,
        "hintlabel": "Hint",
        "hintvalue": "Regime autoritário que durou de 1964 a 1985.",
        "rows": [
            {"letters": [{"letter": "M", "state": "correct", "arialabel": "M, correct position"}]}
        ],
        "roundfinished": false,
        "guesslabel": "Your guess",
        "guessplaceholder": "Type a word",
        "guessmaxlength": 7,
        "submitguess": "Submit guess",
        "forfeitlabel": "Give up",
        "forfeitconfirm": "Are you sure you want to give up?",
        "keyboardlabel": "On-screen keyboard",
        "keyboardenterlabel": "Enter",
        "keyboardbackspacelabel": "Backspace",
        "showcedilla": true,
        "hudhintcost": true,
        "hudhintcostlabel": "You have 0× Magnifying Glass. Costs 1× Magnifying Glass.",
        "canaffordhint": false
    }
}}
<div id="playerwords-round-panel">
    {{#canhint}}
        <div class="text-center mb-3">
            {{#hudhintcost}}
                <p class="mb-1">{{hudhintcostlabel}}</p>
            {{/hudhintcost}}
            <button type="button"
                    id="playerwords-hint-button"
                    class="pw-hint-btn"
                    data-hint-label="{{hintlabel}}"
                    {{^canaffordhint}}disabled{{/canaffordhint}}>
                <i class="fa fa-lightbulb" aria-hidden="true"></i> {{hintbuttonlabel}}
            </button>
        </div>
    {{/canhint}}
    <div id="playerwords-hint-alert" class="alert alert-info"{{^showhint}} hidden{{/showhint}}>
        <strong>{{hintlabel}}</strong> <span id="playerwords-hint-value">{{hintvalue}}</span>
    </div>

    <div class="mod-playerwords-grid mb-3" role="img" aria-label="{{attemptslabel}}">
        {{#rows}}
            <div class="mod-playerwords-row">
                {{#letters}}
                    <span class="mod-playerwords-cell is-{{state}}" aria-label="{{arialabel}}">{{letter}}</span>
                {{/letters}}
            </div>
        {{/rows}}
    </div>

    {{^roundfinished}}
        {{> mod_playerwords/round_play}}
    {{/roundfinished}}
    {{#roundfinished}}
        {{> mod_playerwords/round_result}}
    {{/roundfinished}}
</div>
