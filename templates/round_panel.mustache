{{!
    @template mod_playerwords/round_panel

    Active-round panel: status line, hint control and letter grid, followed by either
    the guess submission form (mod_playerwords/round_play) plus the on-screen keyboard,
    or the post-round result (mod_playerwords/round_result), depending on whether the
    round has finished.

    Every grid cell renders server-side as a plain, non-interactive <span> — already
    played rows carry real per-letter feedback, not-yet-reached rows are simply empty.
    game.js turns the one row currently being typed into real single-character <input>
    boxes at runtime (see activateRow() in amd/src/game.js), which is why the grid
    itself is role="group" rather than role="img": it can legitimately contain
    focusable, editable descendants once a round is under way, not just a static
    read-only history.

    The keyboard renders here rather than inside round_play so it shares this
    template's own (tall) containing block — position: sticky needs enough scrollable
    room above it to stay reachable while the letter grid grows, which the small
    round_play wrapper alone (just the guess form) doesn't have. Because of that,
    game.js's showRoundResult() removes #playerwords-keyboard explicitly whenever it
    replaces #playerwords-round-play with round_result: the keyboard is no longer a
    descendant of the node being swapped, so it would otherwise linger on screen after
    the round finishes.

    Example context (json):
    {
        "attemptslabel": "Attempts",
        "attemptsused": 3,
        "maxattempts": 6,
        "timerenabled": false,
        "timerlabel": "Time left (s):",
        "timeleft": 0,
        "canhint": true,
        "hintbuttonlabel": "Hint",
        "showhint": true,
        "hintlabel": "Hint",
        "hintvalue": "Regime autoritário que durou de 1964 a 1985.",
        "rows": [
            {"letters": [{"letter": "M", "state": "correct", "arialabel": "M, correct position"}]}
        ],
        "roundfinished": false,
        "guesslabel": "Your guess",
        "guessplaceholder": "Type a word",
        "guessmaxlength": 7,
        "submitguess": "Submit guess",
        "forfeitlabel": "Give up",
        "forfeitconfirm": "Are you sure you want to give up?",
        "keyboardlabel": "On-screen keyboard",
        "keyboardenterlabel": "Submit",
        "keyboardentertext": "Enter",
        "keyboardbackspacelabel": "Backspace",
        "showcedilla": true,
        "hudhintcost": true,
        "hudhintcostlabel": "Costs 1× Magnifying Glass (you have 0).",
        "canaffordhint": false
    }
}}
<div id="playerwords-round-panel">
    {{#canhint}}
        <div class="text-center mb-3">
            <button type="button"
                    id="playerwords-hint-button"
                    class="pw-hint-btn"
                    data-hint-label="{{hintlabel}}"
                    {{#hudhintcost}}
                        title="{{hudhintcostlabel}}"
                        aria-label="{{hintbuttonlabel}} — {{hudhintcostlabel}}"
                        data-hud-confirm-title="{{hintbuttonlabel}}"
                        data-hud-confirm-body="{{hudhintcostlabel}}"
                        {{^canaffordhint}}data-hud-confirm-insufficient="1"{{/canaffordhint}}
                    {{/hudhintcost}}>
                <i class="fa fa-lightbulb" aria-hidden="true"></i> {{hintbuttonlabel}}
            </button>
        </div>
    {{/canhint}}
    <div id="playerwords-hint-alert" class="alert alert-info"{{^showhint}} hidden{{/showhint}}>
        <strong>{{hintlabel}}</strong> <span id="playerwords-hint-value">{{hintvalue}}</span>
    </div>

    <div class="mod-playerwords-grid mb-3" role="group" aria-label="{{attemptslabel}}">
        {{#rows}}
            <div class="mod-playerwords-row">
                {{#letters}}
                    <span class="mod-playerwords-cell is-{{state}}" aria-label="{{arialabel}}">{{letter}}</span>
                {{/letters}}
            </div>
        {{/rows}}
    </div>

    {{^roundfinished}}
        {{> mod_playerwords/round_play}}
        <div id="playerwords-keyboard" class="mod-playerwords-keyboard" role="group" aria-label="{{keyboardlabel}}">
            <div class="mod-playerwords-keyboard-row">
                <button type="button" class="pw-key" data-key="Q" tabindex="-1">Q</button>
                <button type="button" class="pw-key" data-key="W" tabindex="-1">W</button>
                <button type="button" class="pw-key" data-key="E" tabindex="-1">E</button>
                <button type="button" class="pw-key" data-key="R" tabindex="-1">R</button>
                <button type="button" class="pw-key" data-key="T" tabindex="-1">T</button>
                <button type="button" class="pw-key" data-key="Y" tabindex="-1">Y</button>
                <button type="button" class="pw-key" data-key="U" tabindex="-1">U</button>
                <button type="button" class="pw-key" data-key="I" tabindex="-1">I</button>
                <button type="button" class="pw-key" data-key="O" tabindex="-1">O</button>
                <button type="button" class="pw-key" data-key="P" tabindex="-1">P</button>
            </div>
            <div class="mod-playerwords-keyboard-row">
                <button type="button" class="pw-key" data-key="A" tabindex="-1">A</button>
                <button type="button" class="pw-key" data-key="S" tabindex="-1">S</button>
                <button type="button" class="pw-key" data-key="D" tabindex="-1">D</button>
                <button type="button" class="pw-key" data-key="F" tabindex="-1">F</button>
                <button type="button" class="pw-key" data-key="G" tabindex="-1">G</button>
                <button type="button" class="pw-key" data-key="H" tabindex="-1">H</button>
                <button type="button" class="pw-key" data-key="J" tabindex="-1">J</button>
                <button type="button" class="pw-key" data-key="K" tabindex="-1">K</button>
                <button type="button" class="pw-key" data-key="L" tabindex="-1">L</button>
                {{#showcedilla}}
                    <button type="button" class="pw-key" data-key="Ç" tabindex="-1">Ç</button>
                {{/showcedilla}}
            </div>
            <div class="mod-playerwords-keyboard-row">
                <button type="button"
                        class="pw-key pw-key-wide pw-key-enter"
                        data-key="ENTER"
                        tabindex="-1"
                        aria-label="{{keyboardenterlabel}}">{{keyboardentertext}}</button>
                <button type="button" class="pw-key" data-key="Z" tabindex="-1">Z</button>
                <button type="button" class="pw-key" data-key="X" tabindex="-1">X</button>
                <button type="button" class="pw-key" data-key="C" tabindex="-1">C</button>
                <button type="button" class="pw-key" data-key="V" tabindex="-1">V</button>
                <button type="button" class="pw-key" data-key="B" tabindex="-1">B</button>
                <button type="button" class="pw-key" data-key="N" tabindex="-1">N</button>
                <button type="button" class="pw-key" data-key="M" tabindex="-1">M</button>
                <button type="button"
                        class="pw-key pw-key-wide pw-key-backspace"
                        data-key="BACKSPACE"
                        tabindex="-1"
                        aria-label="{{keyboardbackspacelabel}}">&#x232b;</button>
            </div>
        </div>
    {{/roundfinished}}
    {{#roundfinished}}
        {{> mod_playerwords/round_result}}
    {{/roundfinished}}
</div>
