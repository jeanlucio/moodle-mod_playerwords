{{!
    @template mod_playerwords/managewords

    Manual words management page for a PlayerWords activity.

    Example context (json):
    {
        "cmid": 1,
        "sesskey": "abc123",
        "backtogameurl": "https://example.com/mod/playerwords/view.php?id=1",
        "backtogamebutton": "Back to game",
        "cansyncglossary": true,
        "syncglossarybutton": "Sync with glossary",
        "managewordslabel": "Manual words",
        "manualwordlabel": "Word",
        "manualhintlabel": "Hint",
        "manualwordplaceholder": "Enter a word",
        "manualhintplaceholder": "Optional hint for students",
        "addwordbutton": "Add word",
        "recentwordslabel": "Word pool",
        "nowordsyet": "No words have been added yet.",
        "wordcolumnlabel": "Word",
        "sourcecolumnlabel": "Source",
        "statuscolumnlabel": "Status",
        "actionscolumnlabel": "Actions",
        "deletewordbutton": "Delete",
        "deletewordconfirm": "Are you sure you want to delete this word? This action cannot be undone.",
        "deletewordtitle": "Delete word",
        "hasrecentwords": true,
        "recentwords": [
            {
                "id": 1,
                "word": "ocean",
                "source": "Manual insertion",
                "approved": "Approved"
            }
        ]
    }
}}
<p>
    <a href="{{{backtogameurl}}}" class="btn btn-link mb-3">{{backtogamebutton}}</a>
</p>

{{#cansyncglossary}}
<div class="card mb-3">
    <div class="card-body">
        <form method="post" action="{{{config.wwwroot}}}/mod/playerwords/managewords.php">
            <input type="hidden" name="id" value="{{cmid}}">
            <input type="hidden" name="syncglossary" value="1">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <button type="submit" class="btn btn-outline-secondary">{{syncglossarybutton}}</button>
        </form>
    </div>
</div>
{{/cansyncglossary}}

<div class="card mb-3">
    <div class="card-body">
        <h3 class="h5">{{managewordslabel}}</h3>
        <form method="post" action="{{{config.wwwroot}}}/mod/playerwords/managewords.php">
            <input type="hidden" name="id" value="{{cmid}}">
            <input type="hidden" name="addword" value="1">
            <input type="hidden" name="sesskey" value="{{sesskey}}">

            <label for="playerwords-manualword" class="form-label">{{manualwordlabel}}</label>
            <input
                type="text"
                id="playerwords-manualword"
                name="manualword"
                class="form-control"
                placeholder="{{manualwordplaceholder}}"
                required
            >

            <label for="playerwords-manualhint" class="form-label mt-2">{{manualhintlabel}}</label>
            <input
                type="text"
                id="playerwords-manualhint"
                name="manualhint"
                class="form-control"
                placeholder="{{manualhintplaceholder}}"
            >

            <button type="submit" class="btn btn-secondary mt-2">{{addwordbutton}}</button>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h3 class="h6">{{recentwordslabel}}</h3>
        {{#hasrecentwords}}
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th scope="col">{{wordcolumnlabel}}</th>
                            <th scope="col">{{sourcecolumnlabel}}</th>
                            <th scope="col">{{statuscolumnlabel}}</th>
                            <th scope="col">{{actionscolumnlabel}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#recentwords}}
                            <tr>
                                <td>{{word}}</td>
                                <td>{{source}}</td>
                                <td>{{approved}}</td>
                                <td>
                                    <form method="post"
                                          action="{{{config.wwwroot}}}/mod/playerwords/managewords.php"
                                          class="mod-playerwords-delete-form"
                                          data-title="{{deletewordtitle}}"
                                          data-confirm="{{deletewordconfirm}}">
                                        <input type="hidden" name="id" value="{{cmid}}">
                                        <input type="hidden" name="deleteword" value="1">
                                        <input type="hidden" name="wordid" value="{{id}}">
                                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            {{deletewordbutton}}
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {{/recentwords}}
                    </tbody>
                </table>
            </div>
        {{/hasrecentwords}}
        {{^hasrecentwords}}
            <p class="mb-0">{{nowordsyet}}</p>
        {{/hasrecentwords}}
    </div>
</div>
