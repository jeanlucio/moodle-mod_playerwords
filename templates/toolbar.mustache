{{!
    @template mod_playerwords/toolbar

    Compact icon toolbar shown above the game board: help, manage words (teacher-only),
    attempt history, ranking and forfeit (hidden outside an active round).

    Example context (json):
    {
        "toolbarhelp": "Help",
        "helptitle": "How to play",
        "canmanagewords": true,
        "managewordsbutton": "Manage words",
        "managewordsurl": "https://example.com/mod/playerwords/managewords.php?id=1",
        "toolbarmyattempts": "Attempt history",
        "myattemptsurl": "https://example.com/mod/playerwords/myattempts.php?id=1",
        "showranking": true,
        "rankingurl": "https://example.com/mod/playerwords/ranking.php?id=1",
        "rankingviewfulllabel": "Full ranking",
        "showforfeit": true,
        "forfeitlabel": "Give up",
        "forfeitconfirm": "Are you sure you want to give up?"
    }
}}
<div class="pw-toolbar">
    <button type="button"
            id="playerwords-help-button"
            class="pw-toolbar-btn"
            title="{{toolbarhelp}}"
            aria-label="{{toolbarhelp}}"
            data-title="{{helptitle}}">
        <i class="fa fa-question-circle" aria-hidden="true"></i>
    </button>
    {{#canmanagewords}}
        <a href="{{{managewordsurl}}}" class="pw-toolbar-btn" title="{{managewordsbutton}}" aria-label="{{managewordsbutton}}">
            <i class="fa fa-cog" aria-hidden="true"></i>
        </a>
    {{/canmanagewords}}
    <a href="{{{myattemptsurl}}}" class="pw-toolbar-btn" title="{{toolbarmyattempts}}" aria-label="{{toolbarmyattempts}}">
        <i class="fa fa-list-alt" aria-hidden="true"></i>
    </a>
    {{#showranking}}
        <a href="{{{rankingurl}}}" class="pw-toolbar-btn" title="{{rankingviewfulllabel}}" aria-label="{{rankingviewfulllabel}}">
            <i class="fa fa-trophy" aria-hidden="true"></i>
        </a>
    {{/showranking}}
    <button type="button"
            id="playerwords-forfeit-button"
            class="pw-toolbar-btn pw-toolbar-btn-danger"
            title="{{forfeitlabel}}"
            aria-label="{{forfeitlabel}}"
            data-title="{{forfeitlabel}}"
            data-confirm="{{forfeitconfirm}}"
            {{^showforfeit}}hidden{{/showforfeit}}>
        <i class="fa fa-door-open" aria-hidden="true"></i>
    </button>
</div>
