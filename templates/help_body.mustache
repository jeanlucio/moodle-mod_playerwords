{{!
    @template mod_playerwords/help_body

    How-to-play help content for a PlayerWords activity, shown inside a modal
    opened from the in-game toolbar (see mod_playerwords/toolbar and amd/src/game.js).

    Example context (json):
    {
        "introtext": "Guess the hidden word within the allowed attempts.",
        "keyboardtext": "You can also type using your device's physical keyboard.",
        "accentstext": "On the game's on-screen keyboard, hold down a vowel key (A, E, I, O, U) to open its accented variants and drag to the one you want — accenting is optional, the game recognizes the word even without one.",
        "legendcorrectlabel": "Correct: the letter is correct and in the right position.",
        "legendpresentlabel": "Present: the letter is in the word but in the wrong position.",
        "legendabsentlabel": "Absent: the letter is not in the word.",
        "attemptstext": "You have a limited number of attempts per round.",
        "hinttext": "A hint may be available, depending on how the teacher configured the activity.",
        "timertext": "Some activities have a time limit per round.",
        "showhud": true,
        "hudtext": "This activity may require PlayerHUD items to start a round or reveal a hint, and can reward you with an item for winning a round.",
        "showgrading": true,
        "gradingtext": "Grading method: Highest grade.",
        "showranking": true,
        "rankingtext": "The ranking adds up your points from every finished round. Ties are broken by fewer attempts used on average, then less time spent on average.",
        "reviewhint": "You can review these instructions anytime by clicking the help icon at the top of the game."
    }
}}
<div class="mod-playerwords-help-body">
    <p>{{introtext}}</p>
    <p>{{keyboardtext}}</p>
    <p class="mod-playerwords-help-accents">{{accentstext}}</p>
    <ul class="mod-playerwords-help-legend">
        <li><span class="pw-legend-swatch is-correct" aria-hidden="true">A</span> {{legendcorrectlabel}}</li>
        <li><span class="pw-legend-swatch is-present" aria-hidden="true">A</span> {{legendpresentlabel}}</li>
        <li><span class="pw-legend-swatch is-absent" aria-hidden="true">A</span> {{legendabsentlabel}}</li>
    </ul>
    <p>{{attemptstext}}</p>
    <p>{{hinttext}}</p>
    <p>{{timertext}}</p>
    {{#showhud}}
        <p>{{hudtext}}</p>
    {{/showhud}}
    {{#showgrading}}
        <p>{{gradingtext}}</p>
    {{/showgrading}}
    {{#showranking}}
        <p>{{rankingtext}}</p>
    {{/showranking}}
    <p>{{reviewhint}}</p>
</div>
