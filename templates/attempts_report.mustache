{{!
    @template mod_playerwords/attempts_report

    All-students attempt report for a PlayerWords activity, shown instead of the "my
    attempts" page to whoever can manage the activity. Paginated, sortable, filterable
    by student.

    Example context (json):
    {
        "activityname": "Vocabulário — Revolução Industrial",
        "activityurl": "https://example.com/mod/playerwords/view.php?id=1",
        "backlabel": "Back to game",
        "cmid": 1,
        "reporttitle": "Attempt history — All students",
        "emptylabel": "No student has finished a round yet.",
        "isempty": false,
        "showranking": true,
        "filterurl": "https://example.com/mod/playerwords/myattempts.php",
        "filterlabel": "Student",
        "filterbuttonlabel": "Filter",
        "currentsort": "date",
        "currentdir": "DESC",
        "studentoptions": [
            {"id": 0, "name": "All students", "selected": true},
            {"id": 5, "name": "Alice Espada", "selected": false}
        ],
        "columns": [
            {"key": "student", "label": "Student", "alignend": false, "url": "https://example.com/mod/playerwords/myattempts.php?id=1&sort=student&dir=ASC", "arrow": ""},
            {"key": "date", "label": "Date", "alignend": false, "url": "https://example.com/mod/playerwords/myattempts.php?id=1&sort=date&dir=ASC", "arrow": " ▼"}
        ],
        "rows": [
            {"student": "Alice Espada", "word": "República", "attemptsused": 3, "timeused": "1:24", "won": true, "score": "10.00", "rankingpoints": "10.00", "datefinished": "1 January 2026, 10:00 AM"}
        ],
        "pagingbar": "<nav aria-label=\"pagination\">…</nav>"
    }
}}
<div class="mod-playerwords-attemptsreport-page">
    <p>
        <a href="{{activityurl}}" class="btn btn-secondary btn-sm">{{backlabel}}</a>
    </p>
    <h2>{{reporttitle}}</h2>

    <form method="get" action="{{filterurl}}" class="row g-2 align-items-end mb-3">
        <input type="hidden" name="id" value="{{cmid}}">
        <input type="hidden" name="sort" value="{{currentsort}}">
        <input type="hidden" name="dir" value="{{currentdir}}">
        <div class="col-auto">
            <label for="playerwords-filter-student" class="form-label">{{filterlabel}}</label>
            <select name="studentid" id="playerwords-filter-student" class="form-select">
                {{#studentoptions}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                {{/studentoptions}}
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-secondary">{{filterbuttonlabel}}</button>
        </div>
    </form>

    {{#isempty}}
        <p class="text-muted">{{emptylabel}}</p>
    {{/isempty}}
    {{^isempty}}
        <div class="table-responsive">
            <table class="table table-sm mod-playerwords-myattempts-table">
                <thead>
                    <tr>
                        {{#columns}}
                            <th scope="col" {{#alignend}}class="text-end"{{/alignend}}>
                                <a href="{{url}}">{{label}}{{arrow}}</a>
                            </th>
                        {{/columns}}
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                        <tr>
                            <td>{{student}}</td>
                            <td>{{word}}</td>
                            <td class="text-end">{{attemptsused}}</td>
                            <td class="text-end">{{timeused}}</td>
                            <td class="text-end">{{score}}</td>
                            {{#showranking}}
                                <td class="text-end">{{rankingpoints}}</td>
                            {{/showranking}}
                            <td>{{datefinished}}</td>
                        </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>
        {{{pagingbar}}}
    {{/isempty}}
</div>
