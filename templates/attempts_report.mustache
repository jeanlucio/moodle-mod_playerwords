{{!
    @template mod_playerwords/attempts_report

    All-students attempt report for a PlayerWords activity, shown instead of the "my
    attempts" page to whoever can manage the activity. Paginated, sortable, filterable
    by student.

    Example context (json):
    {
        "activityname": "Vocabulário — Revolução Industrial",
        "activityurl": "https://example.com/mod/playerwords/view.php?id=1",
        "backlabel": "Back to game",
        "cmid": 1,
        "reporttitle": "Attempt history — All students",
        "emptylabel": "No student has finished a round yet.",
        "isempty": false,
        "showranking": true,
        "filterurl": "https://example.com/mod/playerwords/myattempts.php",
        "filterlabel": "Student",
        "filterbuttonlabel": "Filter",
        "currentsort": "date",
        "currentdir": "DESC",
        "studentoptions": [
            {"id": 0, "name": "All students", "selected": true},
            {"id": 5, "name": "Alice Espada", "selected": false}
        ],
        "columns": [
            {"key": "student", "label": "Student", "alignend": false, "url": "https://example.com/mod/playerwords/myattempts.php?id=1&sort=student&dir=ASC", "arrow": ""},
            {"key": "date", "label": "Date", "alignend": false, "url": "https://example.com/mod/playerwords/myattempts.php?id=1&sort=date&dir=ASC", "arrow": " ▼"}
        ],
        "rows": [
            {"id": 42, "student": "Alice Espada", "word": "República", "attemptsused": 3, "timeused": "1:24", "won": true, "score": "10.00", "rankingpoints": "10.00", "datefinished": "1 January 2026, 10:00 AM"}
        ],
        "pagingbar": "<nav aria-label=\"pagination\">…</nav>",
        "candelete": true,
        "sesskey": "abc123",
        "selectalllabel": "Select all",
        "bulkdeletebutton": "Delete selected",
        "bulkdeletetitle": "Delete attempts",
        "bulkdeleteconfirm": "Are you sure you want to delete the selected attempts? This action cannot be undone.",
        "deleteattemptlabel": "Delete attempt",
        "deleteattemptconfirm": "Are you sure you want to delete this attempt? This action cannot be undone.",
        "showhudwarning": true,
        "hudwarningtext": "PlayerHUD items granted for winning are not removed when an attempt is deleted."
    }
}}
<div class="mod-playerwords-attemptsreport-page">
    <p>
        <a href="{{activityurl}}" class="btn btn-secondary btn-sm">{{backlabel}}</a>
    </p>
    <h2>{{reporttitle}}</h2>

    {{#showhudwarning}}
        <p class="small">{{hudwarningtext}}</p>
    {{/showhudwarning}}

    <form method="get" action="{{filterurl}}" class="row g-2 align-items-end mb-3">
        <input type="hidden" name="id" value="{{cmid}}">
        <input type="hidden" name="sort" value="{{currentsort}}">
        <input type="hidden" name="dir" value="{{currentdir}}">
        <div class="col-auto">
            <label for="playerwords-filter-student" class="form-label">{{filterlabel}}</label>
            <select name="studentid" id="playerwords-filter-student" class="form-select">
                {{#studentoptions}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                {{/studentoptions}}
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-secondary">{{filterbuttonlabel}}</button>
        </div>
    </form>

    {{#isempty}}
        <p class="text-muted">{{emptylabel}}</p>
    {{/isempty}}
    {{^isempty}}
        <form id="playerwords-attempts-form" method="post" action="attemptsreport.php">
            <input type="hidden" name="id" value="{{cmid}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="sort" value="{{currentsort}}">
            <input type="hidden" name="dir" value="{{currentdir}}">
            <input type="hidden" name="studentid" value="{{filteruserid}}">
            <input type="hidden" name="page" value="{{currentpage}}">
            <input type="hidden" id="playerwords-bulk-action" name="bulkaction" value="">

            {{#candelete}}
                <div class="mb-2">
                    <button type="button"
                            id="playerwords-attempts-bulk-delete-btn"
                            class="btn btn-outline-danger btn-sm"
                            data-labelbase="{{bulkdeletebutton}}"
                            data-title="{{bulkdeletetitle}}"
                            data-confirm="{{bulkdeleteconfirm}}"
                            disabled>
                        {{bulkdeletebutton}}
                    </button>
                </div>
            {{/candelete}}

            <div class="table-responsive">
                <table class="table table-sm mod-playerwords-myattempts-table">
                    <thead>
                        <tr>
                            {{#candelete}}
                                <th scope="col">
                                    <input type="checkbox"
                                           id="playerwords-attempts-select-all"
                                           class="form-check-input"
                                           aria-label="{{selectalllabel}}">
                                </th>
                            {{/candelete}}
                            {{#columns}}
                                <th scope="col" {{#alignend}}class="text-end"{{/alignend}}>
                                    <a href="{{url}}">{{label}}{{arrow}}</a>
                                </th>
                            {{/columns}}
                            {{#candelete}}
                                <th scope="col"></th>
                            {{/candelete}}
                        </tr>
                    </thead>
                    <tbody>
                        {{#rows}}
                            <tr>
                                {{#candelete}}
                                    <td>
                                        <input type="checkbox"
                                               name="attemptid[]"
                                               value="{{id}}"
                                               class="form-check-input playerwords-attempts-bulk-check"
                                               aria-label="{{deleteattemptlabel}} — {{student}}">
                                    </td>
                                {{/candelete}}
                                <td>{{student}}</td>
                                <td>{{word}}</td>
                                <td class="text-end">{{attemptsused}}</td>
                                <td class="text-end">{{timeused}}</td>
                                <td class="text-end">{{score}}</td>
                                {{#showranking}}
                                    <td class="text-end">{{rankingpoints}}</td>
                                {{/showranking}}
                                <td>{{datefinished}}</td>
                                {{#candelete}}
                                    <td>
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm playerwords-attempts-single-delete-btn"
                                                data-attemptid="{{id}}"
                                                data-title="{{deleteattemptlabel}}"
                                                data-confirm="{{deleteattemptconfirm}}"
                                                aria-label="{{deleteattemptlabel}} — {{student}}">
                                            {{deleteattemptlabel}}
                                        </button>
                                    </td>
                                {{/candelete}}
                            </tr>
                        {{/rows}}
                    </tbody>
                </table>
            </div>
        </form>
        {{{pagingbar}}}
    {{/isempty}}
</div>
